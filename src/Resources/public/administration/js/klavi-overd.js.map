hronization_flag %}\n                        <div class=\"boolean-config-container\">\n                            <sw-inherit-wrapper v-if=\"selectedSalesChannelId === null\"\n                                                v-model=\"actualConfigData['klavi_overd.config.excludedSubscribersSynchronization']\"\n                                                :inheritedValue=\"selectedSalesChannelId === null ? null : allConfigs['null']['klavi_overd.config.excludedSubscribersSynchronization']\">\n                                <template #content=\"props\">\n                                    <sw-switch-field name=\"klavi_overd.config.excludedSubscribersSynchronization\"\n                                               :label=\"$tc('klaviyo-integration-settings.configs.excludedSubscribersSynchronization.label')\"\n                                               :help-text=\"$tc('klaviyo-integration-settings.configs.excludedSubscribersSynchronization.helpText')\"\n                                               :map-inheritance=\"props\"\n                                               :disabled=\"props.isInherited\"\n                                               :value=\"props.currentValue\"\n                                               @change=\"props.updateCurrentValue\">\n                                    </sw-switch-field>\n                                </template>\n                            </sw-inherit-wrapper>\n                        </div>\n                    {% endblock %}\n\n                    {% block klaviyo_integration_settings_general_old_job_cleanup_flag %}\n                        <div class=\"boolean-config-container\">\n                            <sw-inherit-wrapper v-if=\"selectedSalesChannelId === null\"\n                                                v-model=\"actualConfigData['klavi_overd.config.oldJobCleanup']\"\n                                                :inheritedValue=\"selectedSalesChannelId === null ? null : allConfigs['null']['klavi_overd.config.oldJobCleanup']\">\n                                <template #content=\"props\">\n                                    <sw-switch-field\n                                        :label=\"$tc('klaviyo-integration-settings.configs.oldJobCleanup.label')\"\n                                        :help-text=\"$tc('klaviyo-integration-settings.configs.oldJobCleanup.helpText')\"\n                                        :map-inheritance=\"props\"\n                                        :disabled=\"props.isInherited\"\n                                        :value=\"props.currentValue\"\n                                        @change=\"props.updateCurrentValue\">\n                                    </sw-switch-field>\n                                </template>\n                            </sw-inherit-wrapper>\n                        </div>\n                    {% endblock %}\n\n                    {% block klaviyo_integration_settings_general_old_job_cleanup_period %}\n                        <sw-inherit-wrapper v-if=\"selectedSalesChannelId === null && actualConfigData['klavi_overd.config.oldJobCleanup']\"\n                                            v-model=\"actualConfigData['klavi_overd.config.oldJobCleanupPeriod']\"\n                                            :inheritedValue=\"selectedSalesChannelId === null ? null : allConfigs['null']['klavi_overd.config.oldJobCleanupPeriod']\">\n                            <template #content=\"props\">\n                                <sw-single-select name=\"klavi_overd.config.oldJobCleanupPeriod\"\n                                                  labelProperty=\"label\"\n                                                  valueProperty=\"value\"\n                                                  :options=\"createOldJobCleanupPeriodOptions\"\n                                                  :isInherited=\"props.isInherited\"\n                                                  :disabled=\"props.isInherited\"\n                                                  show-clearable-button\n                                                  :value=\"props.currentValue\"\n                                                  @change=\"props.updateCurrentValue\">\n                                </sw-single-select>\n                            </template>\n                        </sw-inherit-wrapper>\n                    {% endblock %}\n\n                </fieldset>\n            </sw-card>\n        {% endblock %}\n\n    </div>\n{% endblock %}\n";