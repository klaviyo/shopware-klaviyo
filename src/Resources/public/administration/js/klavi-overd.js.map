export default "{% block klaviyo_integration_settings_synchronization_control %}\n    <div class=\"klaviyo-integration-settings-synchronization-control\">\n\n        <fieldset>\n            <legend>{{ $tc('klaviyo-integration-settings.historicalSync.eventsLabel') }}</legend>\n\n            {% block klaviyo_integration_settings_historical_events_scope_notice %}\n                <sw-alert variant=\"info\">\n                    <span v-html=\"$tc('klaviyo-integration-settings.configs.historicalEvents.scopeNotice')\"></span>\n                </sw-alert>\n            {% endblock %}\n\n            {% block klaviyo_integration_settings_synchronization_control_historical_events_date_range %}\n                <sw-container columns=\"5fr 5fr\" gap=\"16px\">\n                    <sw-datepicker\n                            v-model:value=\"historicalEventsFromDate\"\n                            :label=\"$tc('klaviyo_integration_plugin.historical_events_tracking.modal.from_date')\"\n                            :dateType=\"'date'\">\n                    </sw-datepicker>\n                    <sw-datepicker\n                            v-model:value=\"historicalEventsTillDate\"\n                            :label=\"$tc('klaviyo_integration_plugin.historical_events_tracking.modal.until_date')\"\n                            :dateType=\"'date'\">\n                    </sw-datepicker>\n                </sw-container>\n            {% endblock %}\n\n            {% block klaviyo_integration_settings_synchronization_control_without_orders_sync %}\n                <div class=\"boolean-config-container\">\n                    <sw-inherit-wrapper v-model=\"actualConfigData['klavi_overd.config.withoutOrdersSync']\"\n                                        :label=\"$tc('klaviyo-integration-settings.configs.withoutOrdersSync.label')\"\n                                        :helpText=\"$tc('klaviyo-integration-settings.configs.withoutOrdersSync.helpText')\"\n                                        :inheritedValue=\"selectedSalesChannelId === null ? null : allConfigs['null']['klavi_overd.config.withoutOrdersSync']\"\n                                        :customInheritationCheckFunction=\"checkBoolFieldInheritance\">\n                        <template #content=\"props\">\n                            <sw-switch-field name=\"klavi_overd.config.withoutOrdersSync\"\n                                             :mapInheritance=\"props\"\n                                             :disabled=\"props.isInherited\"\n                                             :value=\"props.currentValue\"\n                                             @change=\"props.updateCurrentValue\">\n                            </sw-switch-field>\n                        </template>\n                    </sw-inherit-wrapper>\n                </div>\n            {% endblock %}\n\n            {% block klaviyo_integration_settings_synchronization_control_historical_events_tracking %}\n                <sw-button-process variant=\"ghost\"\n                                   :isLoading=\"historicalEventsJobInteractor.isSynchronizationInProgress\"\n                                   :processSuccess=\"historicalEventsJobInteractor.isSynchronizationSuccess\"\n                                   @click=\"proceedHistoricalEventsSynchronization\"\n                                   @process-finish=\"resetHistoricalEventsSynchronizationState\">\n                    {{ $tc('klaviyo_integration_plugin.historical_events_tracking.schedule_synchronization.button_label') }}\n                </sw-button-process>\n            {% endblock %}\n        </fieldset>\n\n        <fieldset>\n            <legend>{{ $tc('klaviyo-integration-settings.historicalSync.subscribersLabel') }}</legend>\n\n            {% block klaviyo_integration_settings_subscriber_scope_notice %}\n                <sw-alert variant=\"info\">\n                    <span v-html=\"$tc('klaviyo-integration-settings.configs.subscriberSync.scopeNotice')\"></span>\n                </sw-alert>\n            {% endblock %}\n\n            {% block klaviyo_integration_settings_synchronization_control_subscribers_date_range %}\n                <sw-container columns=\"5fr 5fr\" gap=\"16px\">\n                    <sw-datepicker\n                            v-model:value=\"subscribersFromDate\"\n                            :label=\"$tc('klaviyo_integration_plugin.subscribers.modal.from_date')\"\n                            :dateType=\"'date'\">\n                    </sw-datepicker>\n                    <sw-datepicker\n                            v-model:value=\"subscribersTillDate\"\n                            :label=\"$tc('klaviyo_integration_plugin.subscribers.modal.until_date')\"\n                            :dateType=\"'date'\">\n                    </sw-datepicker>\n                </sw-container>\n            {% endblock %}\n\n            {% block klaviyo_integration_settings_synchronization_control_without_subscribers_sync %}\n                <div class=\"boolean-config-container\">\n                    <sw-inherit-wrapper v-model=\"actualConfigData['klavi_overd.config.withoutSubscribersSync']\"\n                                        :label=\"$tc('klaviyo-integration-settings.configs.withoutSubscribersSync.label')\"\n                                        :helpText=\"$tc('klaviyo-integration-settings.configs.withoutSubscribersSync.helpText')\"\n                                        :inheritedValue=\"selectedSalesChannelId === null ? null : allConfigs['null']['klavi_overd.config.withoutSubscribersSync']\"\n                                        :customInheritationCheckFunction=\"checkBoolFieldInheritance\">\n                        <template #content=\"props\">\n                            <sw-switch-field name=\"klavi_overd.config.withoutSubscribersSync\"\n                                             :mapInheritance=\"props\"\n                                             :disabled=\"props.isInherited\"\n                                             :value=\"props.currentValue\"\n                                             @change=\"props.updateCurrentValue\">\n                            </sw-switch-field>\n                        </template>\n                    </sw-inherit-wrapper>\n                </div>\n            {% endblock %}\n\n            {% block klaviyo_integration_settings_synchronization_control_subscribers %}\n                <sw-button-process variant=\"ghost\"\n                                   :isLoading=\"subscribersSynchronizationJobInteractor.isSynchronizationInProgress\"\n                                   :processSuccess=\"subscribersSynchronizationJobInteractor.isSynchronizationSuccess\"\n                                   @click=\"proceedSubscribersSynchronization\"\n                                   @process-finish=\"resetSubscribersSynchronizationState\">\n                    {{ $tc('klaviyo_integration_plugin.subscribers.schedule_synchronization.button_label') }}\n                </sw-button-process>\n            {% endblock %}\n        </fieldset>\n    </div>\n{% endblock %}\n";