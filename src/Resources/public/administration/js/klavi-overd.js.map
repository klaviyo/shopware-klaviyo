export default "{% block klaviyo_integration_settings_synchronization_control %}\n    <div class=\"klaviyo-integration-settings-synchronization-control\">\n\n        {% block klaviyo_integration_settings_synchronization_control_historical_events_tracking %}\n            <sw-button-process variant=\"ghost\"\n                               :isLoading=\"historicalEventsJobInteractor.isSynchronizationInProgress\"\n                               :processSuccess=\"historicalEventsJobInteractor.isSynchronizationSuccess\"\n                               @click=\"openHistoricalEventsModal\"\n                               @process-finish=\"resetHistoricalEventsSynchronizationState\">\n                {{ $tc('klaviyo_integration_plugin.historical_events_tracking.schedule_synchronization.button_label') }}\n            </sw-button-process>\n\n            <sw-modal v-if=\"isHistoricalEventsModalOpen\"\n                      :title=\"$tc('klaviyo_integration_plugin.historical_events_tracking.modal.title')\"\n                      variant=\"small\"\n                      @modal-close=\"closeHistoricalEventsModal\">\n                <template #default>\n                    <sw-datepicker\n                            v-model:value=\"historicalEventsFromDate\"\n                            :label=\"$tc('klaviyo_integration_plugin.historical_events_tracking.modal.from_date')\"\n                            :dateType=\"'date'\">\n                    </sw-datepicker>\n                    <sw-datepicker\n                            v-model:value=\"historicalEventsTillDate\"\n                            :label=\"$tc('klaviyo_integration_plugin.historical_events_tracking.modal.until_date')\"\n                            :dateType=\"'date'\">\n                    </sw-datepicker>\n                </template>\n                <template #modal-footer>\n                    <sw-button variant=\"ghost\" @click=\"closeHistoricalEventsModal\">\n                        {{ $tc('klaviyo_integration_plugin.historical_events_tracking.modal.cancel_button') }}\n                    </sw-button>\n                    <sw-button variant=\"primary\" @click=\"proceedHistoricalEventsSynchronization\">\n                        {{ $tc('klaviyo_integration_plugin.historical_events_tracking.modal.proceed_button') }}\n                    </sw-button>\n                </template>\n            </sw-modal>\n        {% endblock %}\n\n        {% block klaviyo_integration_settings_synchronization_control_subscribers %}\n            <sw-button-process variant=\"ghost\"\n                               :isLoading=\"subscribersSynchronizationJobInteractor.isSynchronizationInProgress\"\n                               :processSuccess=\"subscribersSynchronizationJobInteractor.isSynchronizationSuccess\"\n                               @click=\"scheduleSubscribersSynchronization\"\n                               @process-finish=\"resetSubscribersSynchronizationState\">\n                {{ $tc('klaviyo_integration_plugin.subscribers.schedule_synchronization.button_label') }}\n            </sw-button-process>\n        {% endblock %}\n\n    </div>\n{% endblock %}";