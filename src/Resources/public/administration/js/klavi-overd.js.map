export default "{% block klaviyo_integration_settings_general_tabs %}\n    <sw-tabs position-identifier=\"klaviyo-integration-settings-general-tabs\"\n             :default-item=\"activeTab\"\n             @new-item-active=\"onTabChange\">\n        <template #default=\"{ active }\">\n            {% block klaviyo_integration_settings_general_tabs_configuration %}\n                <sw-tabs-item name=\"general\" :active-tab=\"active\">\n                    {{ $tc('klaviyo-integration-settings.general.title') }}\n                </sw-tabs-item>\n            {% endblock %}\n\n            {% block klaviyo_integration_settings_general_tabs_cookie_consent %}\n                <sw-tabs-item name=\"cookie-consent\" :active-tab=\"active\">\n                    {{ $tc('klaviyo-integration-settings.cookieConsent.title') }}\n                </sw-tabs-item>\n            {% endblock %}\n\n            {% block klaviyo_integration_settings_general_tabs_sync_settings %}\n                <sw-tabs-item name=\"tracking\" :active-tab=\"active\">\n                    {{ $tc('klaviyo-integration-settings.tracking.title') }}\n                </sw-tabs-item>\n            {% endblock %}\n\n            {% block klaviyo_integration_settings_general_tabs_mapping %}\n                <sw-tabs-item name=\"mapping\" :active-tab=\"active\">\n                    {{ $tc('klaviyo-integration-settings.mapping.title') }}\n                </sw-tabs-item>\n            {% endblock %}\n\n            {% block klaviyo_integration_settings_general_tabs_historical_sync %}\n                <sw-tabs-item name=\"historical-sync\" :active-tab=\"active\">\n                    {{ $tc('klaviyo-integration-settings.historicalSync.title') }}\n                </sw-tabs-item>\n            {% endblock %}\n\n            {% block klaviyo_integration_settings_general_tabs_scheduled_sync %}\n                <sw-tabs-item name=\"scheduled-sync\" :active-tab=\"active\">\n                    {{ $tc('klaviyo-integration-settings.scheduledSync.title') }}\n                </sw-tabs-item>\n            {% endblock %}\n\n            {% block klaviyo_integration_settings_general_tabs_popup %}\n                <sw-tabs-item name=\"popup\" :active-tab=\"active\">\n                    {{ $tc('klaviyo-integration-settings.backInStock.title') }}\n                </sw-tabs-item>\n            {% endblock %}\n        </template>\n    </sw-tabs>\n{% endblock %}\n";