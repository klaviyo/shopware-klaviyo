{% block klaviyo_integration_settings_synchronization_control %}
    <div class="klaviyo-integration-settings-synchronization-control">

        <fieldset>
            <legend>{{ $tc('klaviyo-integration-settings.historicalSync.eventsLabel') }}</legend>

            {% block klaviyo_integration_settings_historical_events_scope_notice %}
                <sw-alert variant="info">
                    <span v-html="$tc('klaviyo-integration-settings.configs.historicalEvents.scopeNotice')"></span>
                </sw-alert>
            {% endblock %}

            {% block klaviyo_integration_settings_synchronization_control_historical_events_date_range %}
                <sw-container columns="5fr 5fr" gap="16px">
                    <sw-datepicker
                            v-model="historicalEventsFromDate"
                            :label="$tc('klaviyo_integration_plugin.historical_events_tracking.modal.from_date')"
                            dateType="date">
                    </sw-datepicker>
                    <sw-datepicker
                            v-model="historicalEventsTillDate"
                            :label="$tc('klaviyo_integration_plugin.historical_events_tracking.modal.until_date')"
                            dateType="date">
                    </sw-datepicker>
                </sw-container>
            {% endblock %}

            {% block klaviyo_integration_settings_synchronization_control_without_orders_sync %}
                <div class="boolean-config-container">
                    <sw-inherit-wrapper v-model="actualConfigData['KlaviyoIntegrationPlugin.config.withoutOrdersSync']"
                                        :inheritedValue="selectedSalesChannelId === null ? null : allConfigs['null']['KlaviyoIntegrationPlugin.config.withoutOrdersSync']"
                                        :customInheritationCheckFunction="checkBoolFieldInheritance">
                        <template #content="props">
                            <sw-switch-field name="KlaviyoIntegrationPlugin.config.withoutOrdersSync"
                                             :mapInheritance="props"
                                             :label="$tc('klaviyo-integration-settings.configs.withoutOrdersSync.label')"
                                             :helpText="$tc('klaviyo-integration-settings.configs.withoutOrdersSync.helpText')"
                                             :disabled="props.isInherited"
                                             :value="props.currentValue"
                                             @change="props.updateCurrentValue">
                            </sw-switch-field>
                        </template>
                    </sw-inherit-wrapper>
                </div>
            {% endblock %}

            {% block klaviyo_integration_settings_synchronization_control_historical_events_tracking %}
                <sw-button-process variant="ghost"
                                   :isLoading="historicalEventsJobInteractor.isSynchronizationInProgress"
                                   :processSuccess="historicalEventsJobInteractor.isSynchronizationSuccess"
                                   @click="proceedHistoricalEventsSynchronization"
                                   @process-finish="resetHistoricalEventsSynchronizationState">
                    {{ $tc('klaviyo_integration_plugin.historical_events_tracking.schedule_synchronization.button_label') }}
                </sw-button-process>
            {% endblock %}
        </fieldset>

        <fieldset>
            <legend>{{ $tc('klaviyo-integration-settings.historicalSync.subscribersLabel') }}</legend>

            {% block klaviyo_integration_settings_subscriber_scope_notice %}
                <sw-alert variant="info">
                    <span v-html="$tc('klaviyo-integration-settings.configs.subscriberSync.scopeNotice')"></span>
                </sw-alert>
            {% endblock %}

            {% block klaviyo_integration_settings_synchronization_control_subscribers_date_range %}
                <sw-container columns="5fr 5fr" gap="16px">
                    <sw-datepicker
                            v-model="subscribersFromDate"
                            :label="$tc('klaviyo_integration_plugin.subscribers.modal.from_date')"
                            dateType="date">
                    </sw-datepicker>
                    <sw-datepicker
                            v-model="subscribersTillDate"
                            :label="$tc('klaviyo_integration_plugin.subscribers.modal.until_date')"
                            dateType="date">
                    </sw-datepicker>
                </sw-container>
            {% endblock %}

            {% block klaviyo_integration_settings_synchronization_control_without_subscribers_sync %}
                <div class="boolean-config-container">
                    <sw-inherit-wrapper v-model="actualConfigData['KlaviyoIntegrationPlugin.config.withoutSubscribersSync']"
                                        :inheritedValue="selectedSalesChannelId === null ? null : allConfigs['null']['KlaviyoIntegrationPlugin.config.withoutSubscribersSync']"
                                        :customInheritationCheckFunction="checkBoolFieldInheritance">
                        <template #content="props">
                            <sw-switch-field name="KlaviyoIntegrationPlugin.config.withoutSubscribersSync"
                                             :mapInheritance="props"
                                             :label="$tc('klaviyo-integration-settings.configs.withoutSubscribersSync.label')"
                                             :helpText="$tc('klaviyo-integration-settings.configs.withoutSubscribersSync.helpText')"
                                             :disabled="props.isInherited"
                                             :value="props.currentValue"
                                             @change="props.updateCurrentValue">
                            </sw-switch-field>
                        </template>
                    </sw-inherit-wrapper>
                </div>
            {% endblock %}

            {% block klaviyo_integration_settings_synchronization_control_subscribers %}
                <sw-button-process variant="ghost"
                                   :isLoading="subscribersSynchronizationJobInteractor.isSynchronizationInProgress"
                                   :processSuccess="subscribersSynchronizationJobInteractor.isSynchronizationSuccess"
                                   @click="proceedSubscribersSynchronization"
                                   @process-finish="resetSubscribersSynchronizationState">
                    {{ $tc('klaviyo_integration_plugin.subscribers.schedule_synchronization.button_label') }}
                </sw-button-process>
            {% endblock %}
        </fieldset>
    </div>
{% endblock %}
