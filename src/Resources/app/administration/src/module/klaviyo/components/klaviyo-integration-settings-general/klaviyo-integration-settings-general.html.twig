{% block klaviyo_integration_settings_general %}
    <div>
        {% block klaviyo_integration_settings_general_tab_navigation %}
            <klaviyo-integration-settings-general-tabs
                :active-tab="activeTab"
                @tab-change="activeTab = $event">
            </klaviyo-integration-settings-general-tabs>
        {% endblock %}
        <sw-card :title="$tc('klaviyo-integration-settings.general.title')"
                 v-if="activeTab === 'general'">
            <sw-container gap="0px 32px" columns="auto 1fr" justify="start" align="center">
                {% block klaviyo_integration_settings_general_enabled %}
                    <sw-switch-field
                        v-if="selectedSalesChannelId !== null"
                        v-model:value="actualConfigData['klavi_overd.config.enabled']"
                        name="klavi_overd.config.enabled"
                        :label="$tc('klaviyo-integration-settings.configs.enabled.label')"
                        :helpText="$tc('klaviyo-integration-settings.configs.enabled.helpText')">
                    </sw-switch-field>
                {% endblock %}

                {% block klaviyo_integration_settings_general_test_api %}
                    <sw-button-process variant="ghost" v-if="selectedSalesChannelId !== null"
                                       :isLoading="apiValidationInProgress"
                                       @click="validateApiCredentials">
                        {{ $tc('klaviyo-integration-settings.configs.apiValidation.buttonLabel') }}
                    </sw-button-process>
                {% endblock %}
            </sw-container>

            <fieldset>
                <legend>{{ $tc('klaviyo-integration-settings.general.fieldsets.apiCredentials') }}</legend>

                {% block klaviyo_integration_settings_general_credentials_alert %}
                    <sw-alert v-if="selectedSalesChannelId === null" variant="warning">
                        {{ $t('klaviyo-integration-settings.general.credentialsAlert') }}
                    </sw-alert>
                {% endblock %}

                <sw-container gap="0px 32px" columns="1fr 1fr" v-if="selectedSalesChannelId !== null">
                    {% block klaviyo_integration_settings_general_private_api_key %}
                        <sw-password-field
                            v-model:value="actualConfigData['klavi_overd.config.privateApiKey']"
                            name="klavi_overd.config.privateApiKey"
                            :label="$tc('klaviyo-integration-settings.configs.privateApiKey.label')"
                            :helpText="$tc('klaviyo-integration-settings.configs.privateApiKey.helpText')"
                            :error="privateKeyErrorState"
                            required>
                        </sw-password-field>
                    {% endblock %}

                    {% block klaviyo_integration_settings_general_public_api_key %}
                        <sw-text-field
                            v-model:value="actualConfigData['klavi_overd.config.publicApiKey']"
                            name="klavi_overd.config.publicApiKey"
                            :label="$tc('klaviyo-integration-settings.configs.publicApiKey.label')"
                            :helpText="$tc('klaviyo-integration-settings.configs.publicApiKey.helpText')"
                            :error="publicKeyErrorState"
                            required>
                        </sw-text-field>
                    {% endblock %}
                </sw-container>

                {% block klaviyo_integration_settings_general_double_opt_in_alert %}
                    <sw-alert v-if="selectedSalesChannelId !== null" variant="info">
                        {{ $t('klaviyo-integration-settings.general.doubleoptinAlert') }}
                    </sw-alert>
                {% endblock %}

                {% block klaviyo_integration_settings_general_klaviyo_list_for_subscribers_sync %}
                    <sw-single-select name="klavi_overd.config.klaviyoListForSubscribersSync"
                                      v-if="selectedSalesChannelId !== null"
                                      v-model:value="actualConfigData['klavi_overd.config.klaviyoListForSubscribersSync']"
                                      ref="newsletterListId"
                                      :label="$tc('klaviyo-integration-settings.configs.klaviyoListForSubscribersSync.label')"
                                      :helpText="$tc('klaviyo-integration-settings.configs.klaviyoListForSubscribersSync.helpText')"
                                      :error="listIdErrorState"
                                      :options="createListsOptions"
                                      :disabled="areListsLoading"
                                      :isLoading="areListsLoading"
                                      required>
                    </sw-single-select>
                {% endblock %}
            </fieldset>
        </sw-card>

        {% block klaviyo_integration_settings_cookie_consent %}
            <sw-card :title="$tc('klaviyo-integration-settings.cookieConsent.title')"
                     v-if="activeTab === 'cookie-consent'">
                <fieldset>
                    <legend>{{ $tc('klaviyo-integration-settings.cookieConsent.title') }}</legend>

                    <sw-inherit-wrapper
                        class="cookie-consent-inheritance"
                        v-model:value="actualConfigData['klavi_overd.config.cookieConsent']"
                        :inheritedValue="selectedSalesChannelId === null ? null : allConfigs['null']['klavi_overd.config.cookieConsent']"
                        :label="$tc('klaviyo-integration-settings.configs.cookieConsent.label')"
                        :help-text="$tc('klaviyo-integration-settings.configs.cookieConsent.helpText')">
                        <template #content="props">
                            <sw-single-select name="klavi_overd.config.cookieConsent"
                                              labelProperty="label"
                                              valueProperty="value"
                                              :options="createCookieConsentOptions"
                                              :isInherited="props.isInherited"
                                              :disabled="props.isInherited"
                                              show-clearable-button
                                              :modelValue="props.currentValue"
                                              @update:value="props.updateCurrentValue">
                            </sw-single-select>
                        </template>
                    </sw-inherit-wrapper>

                    <div class="boolean-config-container">
                        <sw-inherit-wrapper
                            v-model:value="actualConfigData['klavi_overd.config.isInitializeKlaviyoAfterInteraction']"
                            :inheritedValue="selectedSalesChannelId === null ? null : allConfigs['null']['klavi_overd.config.isInitializeKlaviyoAfterInteraction']"
                            :customInheritationCheckFunction="checkBoolFieldInheritance">
                            <template #content="props">
                                <sw-switch-field name="klavi_overd.config.isInitializeKlaviyoAfterInteraction"
                                           :label="$tc('klaviyo-integration-settings.general.initialization.label')"
                                           :helpText="$tc('klaviyo-integration-settings.general.initialization.helpText')"
                                           :mapInheritance="props"
                                           :disabled="props.isInherited"
                                           :modelValue="props.currentValue"
                                           @update:value="props.updateCurrentValue">
                                </sw-switch-field>
                            </template>
                        </sw-inherit-wrapper>
                    </div>

                    {% block klaviyo_integration_settings_consent_scope_notice %}
                        <sw-alert variant="info">
                            {{ $tc('klaviyo-integration-settings.configs.cookieConsent.scopeNotice') }}
                        </sw-alert>
                    {% endblock %}

                </fieldset>
            </sw-card>
        {% endblock %}

        <sw-card :title="$tc('klaviyo-integration-settings.mapping.title')"
                 v-if="activeTab === 'mapping'">
            {% block klaviyo_integration_settings_general_varian_for_bis %}
                <sw-inherit-wrapper v-model:value="actualConfigData['klavi_overd.config.bisVariantField']"
                                    :inheritedValue="selectedSalesChannelId === null ? null : allConfigs['null']['klavi_overd.config.bisVariantField']"
                                    :label="$tc('klaviyo-integration-settings.configs.bisVariantField.label')"
                                    :help-text="$tc('klaviyo-integration-settings.configs.bisVariantField.helpText')">
                    <template #content="props">
                        <sw-single-select name="klavi_overd.config.bisVariantField"
                                          labelProperty="label"
                                          valueProperty="value"
                                          :options="createBisVariantFieldOptions"
                                          :isInherited="props.isInherited"
                                          :disabled="props.isInherited"
                                          show-clearable-button
                                          :modelValue="props.currentValue"
                                          @update:value="props.updateCurrentValue">
                        </sw-single-select>
                    </template>
                </sw-inherit-wrapper>
            {% endblock %}

            {% block klaviyo_integration_settings_general_order_identification %}
                <sw-inherit-wrapper v-model:value="actualConfigData['klavi_overd.config.orderIdentification']"
                                    :inheritedValue="selectedSalesChannelId === null ? null : allConfigs['null']['klavi_overd.config.orderIdentification']"
                                    :label="$tc('klaviyo-integration-settings.configs.orderIdentification.label')"
                                    :help-text="$tc('klaviyo-integration-settings.configs.orderIdentification.helpText')">
                    <template #content="props">
                        <sw-single-select name="klavi_overd.config.orderIdentification"
                                          labelProperty="label"
                                          valueProperty="value"
                                          :options="createOrderIdentificationFieldOptions"
                                          :isInherited="props.isInherited"
                                          :disabled="props.isInherited"
                                          show-clearable-button
                                          :modelValue="props.currentValue"
                                          @update:value="props.updateCurrentValue">
                        </sw-single-select>
                    </template>
                </sw-inherit-wrapper>
            {% endblock %}

            {% block klaviyo_integration_settings_customer_fields %}
                <klaviyo-integration-settings-customer
                    :allConfigs="allConfigs"
                    :mappingErrorStates="mappingErrorStates">
                </klaviyo-integration-settings-customer>
            {% endblock %}

            {% block klaviyo_integration_settings_order_fields %}
                <klaviyo-integration-settings-order
                    :allConfigs="allConfigs"
                    :mappingErrorStates="mappingErrorStates">
                </klaviyo-integration-settings-order>
            {% endblock %}
        </sw-card>

