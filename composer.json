{
    "version": "1.22.0",
    "name": "klaviyo/shopware-klaviyo",
    "description": "Shopware 6 plugin for Klaviyo integration",
    "type": "shopware-platform-plugin",
    "license": "proprietary",
    "authors": [
        {
            "name": "Overdose",
            "homepage": "https://overdose.digital/"
        }
    ],
    "autoload": {
        "psr-4": {
            "Klaviyo\\Integration\\": "src/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "dependencies/*",
            "options": {
                "symlink": false
            }
        }
    ],
    "extra": {
        "shopware-plugin-class": "Klaviyo\\Integration\\klavi_overd",
        "plugin-icon": "src/Resources/config/plugin.png",
        "label": {
            "de-DE": "Klaviyo: Email Marketing & SMS",
            "en-GB": "Klaviyo: Email Marketing & SMS"
        },
        "description": {
            "de-DE": "Plugin, das Klaviyo mit Shopware verbindet und wesentliche Funktionen zur Nutzung von E-Mail-Marketingkampagnen bietet",
            "en-GB": "Plugin that connects Klaviyo with Shopware and provides essential functionality to use email marketing campaigns"
        }
    },
    "require": {
        "php": "^7.4 || ^8.0",
        "shopware/administration": ">=6.4.4.0, <6.5.0.0",
        "shopware/core": ">=6.4.4.0, <6.5.0.0",
        "shopware/storefront": ">=6.4.4.0, <6.5.0.0",
        "ext-json": "*"
    },
    "scripts": {
        "lint:php": "find src -name '*.php' -print0 | xargs -0 -n1 php -l",
        "lint:php:newsletter-language": [
            "@php -l src/Klaviyo/Gateway/Translator/NewsletterSubscriberPropertiesTranslator.php",
            "@php -l src/Klaviyo/Gateway/Translator/SubscribersToKlaviyoRequestsTranslator.php",
            "@php -l src/Klaviyo/Gateway/Translator/RealSubscribersToKlaviyoRequestsTranslator.php",
            "@php -l src/Klaviyo/Client/ApiTransfer/Message/Profiles/Common/ProfileContactInfo.php",
            "@php -l src/Klaviyo/Gateway/KlaviyoGateway.php",
            "@php -l src/Model/UseCase/Operation/SubscriberSyncOperation.php",
            "@php -l src/Klaviyo/Gateway/Translator/CartEventRequestTranslator.php",
            "@php -l src/EventListener/AddPluginExtensionToPageDTOEventListener.php",
            "@php -l src/Klaviyo/Client/Serializer/Normalizer/AddProfilesToListRequestsNormalizer.php",
            "@php -l src/Klaviyo/Client/Serializer/Normalizer/RealSubscribersToKlaviyoRequestNormalizer.php",
            "@php -l src/Klaviyo/Client/Serializer/Normalizer/SubscribeToListRequestNormalizer.php"
        ]
    }
}
